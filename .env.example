# ==============================================================================
# Campus Library Borrowing System - Production Environment Variables Template
# Copy this file to .env and configure real secrets before running in production:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 宿主机端口映射 (Host Ports)
# ------------------------------------------------------------------------------
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. 关系型数据库配置 (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_DB=library_system
POSTGRES_USER=library
POSTGRES_PASSWORD=replace_with_strong_production_postgres_password_here
TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# 3. 高速缓存配置 (Redis 8)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_production_redis_password_here

# ------------------------------------------------------------------------------
# 4. 安全凭证与令牌配置 (JWT Security)
# 必填且无默认值: 后端启动时会强制校验，缺失、过短或命中历史泄露指纹均拒绝启动。
# 生成方式: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_base64_48

# ------------------------------------------------------------------------------
# 5. AI 大语言模型接口配置 (DeepSeek / OpenAI 兼容接口)
# ------------------------------------------------------------------------------
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key_here
AI_DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 6. 数据备份配置 (Backup Settings)
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/campus_library
RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 7. 前端产物 API 地址 (Stage 10-K)
#
# 前端是 Flutter Web，环境标识与接口地址都是**构建期**常量（运行期无法覆盖），
# 所以改这里之后必须重新构建镜像：docker compose -f docker-compose.prod.yml build frontend
#
# 默认留空 = 前端在运行时从页面 origin 推导接口地址（https://<你的域名>/api/v1）。
# 生产网关把前端与 /api/ 挂在同一域名下，天然同源，因此多数情况不需要填。
# 仅当前后端**跨域**部署时才填绝对地址，例如：
#   PUBLIC_API_BASE_URL=https://api.example.com/api/v1
# ------------------------------------------------------------------------------
PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------------------
# 8. 跨域来源白名单 (CORS Allowed Origins)
#
# 同源部署（推荐形态）无需改动；若前端部署在其它域名/端口，必须在此显式列出，
# 否则浏览器会拦下跨域请求（现象：后端健康、前端所有接口失败）。
# 多个来源用英文逗号分隔，支持端口通配：
#   APP_CORS_ALLOWED_ORIGINS=https://library.your-domain.edu.cn,https://www.your-domain.edu.cn
# ------------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ------------------------------------------------------------------------------
# 9. 演示数据开关 (Demo Data)
#
# false（默认，生产必须保持）：Flyway V9 写入的演示账号会被 V11 禁用并作废口令哈希，
#   全新部署后可用账号数为 0，需按部署指南 5.1 节做一次管理员引导。
# true：启用 student_demo / librarian_demo / admin_demo（口令均为 123456）。
#   等同于对外暴露一个已知口令的管理员账号，**仅限隔离的答辩演示环境**。
# ------------------------------------------------------------------------------
DEMO_DATA_ENABLED=false

# ------------------------------------------------------------------------------
# 9.1 自助注册开关 (Public Registration)
#
# true（默认）：读者可在登录页点「立即注册」自助建号，注册后仅获得 STUDENT 角色
#   （17 项读者权限，无任何管理权限），注册成功即自动登录。
# false：关闭自助注册，接口返回 403 与"自助注册已关闭"提示，注册入口会直接报错；
#   此时账号一律由管理员在「系统管理 → 用户管理」或部署引导流程发放。
#
# 建议：公网可访问的正式部署设为 false（否则任何人都能建账号）；
#       仅在内网/演示环境保留 true 以便学生自助使用。
# ------------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=true

# ------------------------------------------------------------------------------
# 10. 首次部署管理员引导 (Stage 10-L)
#
# 生产库初始化后没有任何可用账号（演示账号被 V11 禁用）。首次部署时填写下列变量
# 并启动一次后端，即可自动创建一个 ADMIN 账号；**建号确认可登录后请立即清空/删除这几行**。
#   - 口令需 ≥8 位且同时包含字母与数字，否则会被拒绝且不创建账号；
#   - 幂等：同名账号已存在时只记录并跳过，不覆盖既有口令、不重复授权；
#   - 日志不会输出口令。
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NICKNAME=图书馆管理员
