# ======================================================================
# Campus Library Borrowing System - .gitignore
# ======================================================================

# Backend (Java / Maven)
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/release.properties
*.class
*.jar
*.war
*.ear

# Frontend (Flutter / Dart)
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/release/

# IDE & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs & Runtime data
logs/
*.log
*.hprof

# Environment local secrets
# .env 含数据库口令与 JWT 签名密钥，必须永久禁止入库（2026-09 因曾提交而轮换过一次）
.env
.env.local
.env.*.local
*.pem
*.key

# Tooling runtime state
# .mimosa 是安全扫描工具的 hook 基线缓存，内部保存了源文件快照（含历史密钥），
# 必须忽略，否则 git add . 会把密钥副本一并提交。
# 两种写法都保留: `.mimosa/` 匹配任意层级，`**/.mimosa/` 显式声明嵌套场景。
.mimosa/
**/.mimosa/
