# ==============================================================================
# 后端镜像构建上下文忽略规则（构建上下文为 ./backend）
# 必须保留: pom.xml、.mvn/、mvnw、src/ —— 缺少任一都会导致镜像构建失败
# ==============================================================================

# 本地编译产物（Dockerfile 内部会重新构建，带入只会拖慢上下文传输并污染缓存）
target/

# 工具运行时状态与 IDE 残留
.mimosa
**/.mimosa
.idea
*.iml

# 日志与本地环境文件
*.log
logs/
.env
.env.*
*.pem
*.key

# 版本控制与文档
.git
.gitignore
*.md
